# Opt-in assistant and live mode only. Use a SEPARATE Google Cloud project from the experiments.
# Never put the experiments' GEMINI_API_KEY here. This file is an example; copy to ui/.env (gitignored).
ASSISTANT_GEMINI_API_KEY=
ASSISTANT_GEMINI_MODEL=gemini-3.5-flash-lite
ASSISTANT_DAILY_CAP=50
ASSISTANT_PORT=5182
