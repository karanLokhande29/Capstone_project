{
  "name": "rbi-oblibench-command-center",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RBI-ObliBench Command Center: an explainable, read-only product layer over the RBI-ObliBench research record.",
  "scripts": {
    "ingest": "python3 scripts/ingest.py",
    "calibrate": "python3 scripts/calibrate.py",
    "dev": "vite",
    "server": "tsx server/index.ts",
    "build": "npm run data && tsc -b && vite build",
    "preview": "vite preview",
    "build:azure": "npm run data && tsc -b && VITE_NO_PROXY=1 vite build",
    "deploy:azure": "npm run build:azure && bash scripts/deploy_azure.sh",
    "build:hosted": "npm run data && tsc -b && VITE_ARTIFACT=1 vite build && python3 scripts/artifact_page.py",
    "typecheck": "tsc -b --pretty false",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:py": "python3 -m pytest -q -o addopts= -p no:cacheprovider scripts/tests api/tests",
    "check:dist": "python3 scripts/check_dist.py",
    "data": "python3 scripts/build_demo_data.py",
    "api": "python3 api/server.py",
    "api:bundle": "python3 api/build_bundle.py",
    "present:local": "sh -c 'MODE=presenter python3 api/server.py & API=$!; trap \"kill $API\" EXIT; vite --open /present'"
  },
  "dependencies": {
    "@hono/node-server": "^1.19.5",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@tanstack/react-table": "^8.21.3",
    "@xyflow/react": "^12.8.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "hono": "^4.9.9",
    "lucide-react": "^0.544.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.3",
    "recharts": "^3.2.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@tailwindcss/vite": "^4.1.13",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^6.1.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "jsdom": "^27.0.0",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.6",
    "typescript": "~5.9.2",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
